---
import hobbies from "@/data/hobbies";
---

<div class="flex flex-col gap-6 md:flex-row md:flex-wrap">
  {
    hobbies.map((hobby) => (
      <div>
        <a href={hobby.link} class="bg-gray-800 text-white border border-sky-300 rounded p-1">
          {`${hobby.title} (${hobby.description})`}
        </a>
      </div>
    ))
  }
</div>